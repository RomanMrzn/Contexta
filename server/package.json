{
  "name": "contexta-server",
  "version": "1.0.0",
  "description": "Contexta backend server",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@clerk/clerk-sdk-node": "^5.1.6",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
